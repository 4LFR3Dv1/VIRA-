{
  "name": "vira",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test:runtime": "node --test backend/event-sourcing.test.mjs",
    "test:adversarial": "node --test backend/event-sourcing-adversarial.test.mjs backend/http-security.test.mjs",
    "test:cache": "node --test backend/txline-catalog-cache.test.mjs",
    "test:replay": "node --test backend/verified-round-replay.test.mjs",
    "test:commitment": "node --test backend/round-commitment.test.mjs",
    "test:social": "node --test backend/share-store.test.mjs backend/share-copy.test.mjs",
    "test:picks": "node --test backend/vira-picks-resolvers.test.mjs backend/vira-picks-market-observed.test.mjs backend/vira-picks-regular-time-authority.test.mjs backend/vira-picks-store.test.mjs backend/vira-picks-share.test.mjs backend/vira-picks-http.test.mjs",
    "test:moments": "node --experimental-strip-types --test backend/match-moment-director.test.mjs",
    "test:room-experience": "node --experimental-strip-types --test src/features/match-room/derive-room-experience.test.mjs",
    "test:lobby-experience": "node --experimental-strip-types --test src/features/lobby/fixture-selection.test.mjs",
    "test:home-narrative": "node --experimental-strip-types --test src/features/home/home-narrative.test.mjs",
    "test:matchday-topbar": "node --experimental-strip-types --test src/app/shell/matchday-topbar-model.test.mjs",
    "test:i18n": "node --experimental-strip-types --test src/i18n/i18n.test.mjs",
    "test:companion": "node --experimental-strip-types --test src/features/companion/companion.test.mjs backend/companion-push.test.mjs",
    "test:judge-playback": "node --test backend/football-events.test.mjs backend/verified-round-replay.test.mjs backend/http-security.test.mjs backend/verified-playback-seed.test.mjs backend/public-playback.test.mjs backend/judge-guide-contract.test.mjs && node --experimental-strip-types --test src/features/guided-playback/guided-playback-model.test.mjs",
    "test:tournament-journey": "node --test backend/tournament-journey.test.mjs",
    "test:e2e:two-device": "npm run test:browser:consumer",
    "test:runtime:two-device-simulation": "node --test --test-name-pattern=\"domain ledger restores competitive room\" backend/event-sourcing.test.mjs",
    "certify:match": "node scripts/ci/certify-match.mjs",
    "soak:match": "node scripts/ci/soak-match.mjs",
    "test:deployment:projection": "node scripts/ci/audit-consumer-projection.mjs",
    "check:share-visuals": "node scripts/ci/render-share-samples.mjs",
    "test:browser:smoke": "playwright test tests/e2e/deployment-readonly-smoke.spec.ts",
    "test:browser:smoke:desktop": "playwright test tests/e2e/deployment-readonly-smoke.spec.ts --project=chromium-desktop",
    "test:browser:smoke:mobile": "playwright test tests/e2e/deployment-readonly-smoke.spec.ts --project=chromium-mobile-viewport",
    "test:browser:consumer": "playwright test tests/e2e/consumer-happy-path.spec.ts --project=chromium-desktop",
    "test:browser:consumer:triple": "playwright test tests/e2e/consumer-happy-path.spec.ts --project=chromium-desktop --repeat-each=3",
    "test:browser:consumer:webkit": "playwright test tests/e2e/consumer-happy-path.spec.ts --project=mobile-webkit",
    "test:browser:picks": "playwright test tests/e2e/vira-picks.spec.ts --project=chromium-desktop --project=chromium-mobile-viewport --project=mobile-webkit",
    "test:browser:judge": "playwright test tests/e2e/judge-guide.spec.ts --project=chromium-desktop --project=chromium-mobile-viewport --project=mobile-webkit",
    "test:browser:tournament-journey": "npm run build && playwright test tests/e2e/tournament-journey.spec.ts --project=chromium-desktop --project=chromium-mobile-viewport --project=mobile-webkit",
    "profile:companion:pip": "node scripts/ci/profile-companion-pip.mjs",
    "demo:capture": "npm run build && node scripts/demo/capture-consumer-demo.mjs",
    "demo:voice": "node scripts/demo/prepare-narration.mjs",
    "demo:compose": "node scripts/demo/compose-final-demo.mjs",
    "demo:v2:capture": "npm run build && node scripts/demo/capture-v2-product.mjs",
    "demo:v2:captions": "node scripts/demo/generate-v2-captions.mjs",
    "demo:v2:compose": "node scripts/demo/compose-final-demo-v2.mjs",
    "test:all": "npm run typecheck && node --test backend/e2e-mode.test.mjs backend/event-sourcing.test.mjs backend/event-sourcing-adversarial.test.mjs backend/http-security.test.mjs backend/http-routing.test.mjs backend/pwa-assets.test.mjs backend/txline-catalog-cache.test.mjs backend/txline-stream.test.mjs backend/verified-round-replay.test.mjs backend/verified-playback-seed.test.mjs backend/public-playback.test.mjs backend/judge-guide-contract.test.mjs backend/tournament-journey.test.mjs backend/round-commitment.test.mjs backend/share-store.test.mjs backend/share-copy.test.mjs backend/share-image-png.test.mjs backend/home-projection.test.mjs backend/editorial-domain.test.mjs backend/fixture-consumer-projection.test.mjs backend/competition-registry.test.mjs backend/canonical-market.test.mjs backend/consumer-cadence.test.mjs backend/football-events.test.mjs backend/vira-picks-resolvers.test.mjs backend/vira-picks-market-observed.test.mjs backend/vira-picks-regular-time-authority.test.mjs backend/vira-picks-store.test.mjs backend/vira-picks-share.test.mjs backend/vira-picks-http.test.mjs && node --experimental-strip-types --test src/features/guided-playback/guided-playback-model.test.mjs && npm run test:moments && npm run test:room-experience && npm run test:lobby-experience && npm run test:home-narrative && npm run test:matchday-topbar && npm run test:i18n && npm run test:companion",
    "test:container": "node scripts/ci/container-smoke.mjs",
    "verify": "npm run build && npm run test:all",
    "dev": "vite",
    "backend:dev": "node backend/server.mjs",
    "txline:setup": "node scripts/txline/free-tier-setup.mjs",
    "txline:setup:devnet": "node scripts/txline/free-tier-setup.mjs --network devnet --service-level 1",
    "txline:setup:mainnet-realtime": "node scripts/txline/free-tier-setup.mjs --network mainnet --service-level 12",
    "txline:discover": "node scripts/txline/discover-fixtures.mjs --save-payloads",
    "solana:commitment:prove": "node scripts/solana/publish-commitment-vector.mjs"
  },

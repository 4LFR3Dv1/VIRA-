# VIRA frontend
VITE_VIRA_API_ORIGIN=http://127.0.0.1:8787
VITE_VIRA_PICKS_ENABLED=true

# TxLINE backend
# Use one network consistently across Solana RPC, program ID, guest JWT and activation endpoint.
# mainnet offers service level 1 delayed and service level 12 real-time World Cup data.
# devnet documents service level 1; verify on-chain pricing before using another devnet row.
TXLINE_NETWORK=mainnet
TXLINE_JWT=
TXLINE_API_TOKEN=
TXLINE_FIXTURE_ID=
TXLINE_WALLET_ADDRESS=
TXLINE_SERVICE_LEVEL_ID=1
TXLINE_SUBSCRIPTION_TX=

# Runtime
PORT=8787
VIRA_DATA_DIR=./data/vira
VIRA_INTERNAL_INGEST_ENABLED=false
VIRA_REQUIRE_TXLINE_CREDENTIALS=false
VIRA_ADMIN_TOKEN=
VIRA_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VIRA_ROUND_ANSWER_WINDOW_SEC=30

# VIRA Picks (globally enabled, isolated pre-match social predictions)
VIRA_PICKS_ENABLED=true
VIRA_PICKS_MARKET_FRESH_MS=300000
# Leave empty until exact provider identifiers are verified from real TxLINE responses.

# Solana round commitments (optional, asynchronous, devnet only)
VIRA_SOLANA_COMMITMENT_ENABLED=false
VIRA_SOLANA_NETWORK=devnet
VIRA_SOLANA_RPC_URL=https://api.devnet.solana.com
VIRA_SOLANA_KEYPAIR_PATH=.txline/wallet-devnet.json
# Alternative to a file path: JSON array containing the 64-byte secret key.
VIRA_SOLANA_KEYPAIR_JSON=
